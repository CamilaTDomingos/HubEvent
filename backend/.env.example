# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Project Settings → API).

SUPABASE_URL=https://SEU-PROJETO.supabase.co

# ATENÇÃO: a service_role ignora RLS. Use SOMENTE aqui no backend,
# nunca no frontend e nunca faça commit do .env real.
SUPABASE_SERVICE_ROLE_KEY=

PORT=3001

# Assistente de IA (Gemini). Crie a chave em https://aistudio.google.com/apikey
# Fica SÓ aqui no backend: o frontend nunca fala com o Gemini direto.
GEMINI_API_KEY=
# Modelo usado pelo assistente. O padrão é o alias do Flash estável mais
# recente; para fixar uma versão, use o nome exato listado no AI Studio.
GEMINI_MODEL=gemini-flash-latest
# Tempo máximo de espera pela resposta da IA, em milissegundos
GEMINI_TIMEOUT_MS=30000
# Perguntas por usuário (limite em memória, zera quando o servidor reinicia)
ASSISTENTE_LIMITE_MINUTO=5
ASSISTENTE_LIMITE_DIA=50
