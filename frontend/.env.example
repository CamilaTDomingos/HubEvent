# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Variáveis com prefixo VITE_ vão para o navegador,
# então aqui entra apenas a chave pública (anon), nunca a service_role.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Endereço do backend Express (mesma porta do PORT em backend/.env)
VITE_API_URL=http://localhost:3001
